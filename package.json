{
  "name": "byteplus-rtc-aigc-demo",
  "version": "1.5.0",
  "private": true,
  "license": "BSD-3-Clause",
  "scripts": {
    "setup": "npm ci && npm --prefix server ci && npm --prefix web ci",
    "dev": "npm run dev:realtime",
    "dev:realtime": "node scripts/dev.cjs realtime",
    "dev:flexible": "node scripts/dev.cjs flexible",
    "dev:server": "node scripts/dev.cjs server",
    "dev:web": "node scripts/dev.cjs web",
    "build": "npm --prefix web run build",
    "typecheck": "npm --prefix web run typecheck",
    "test": "node --test scripts/*.test.cjs && npm --prefix server test && npm --prefix web test",
    "dev:web:flexible": "node scripts/dev.cjs web flexible"
  },
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.4"
}
