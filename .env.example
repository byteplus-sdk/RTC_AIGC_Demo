# Required: both modes
RTC_APP_ID=
RTC_APP_KEY=
BYTEPLUS_ACCESS_KEY_ID=
BYTEPLUS_SECRET_ACCESS_KEY=

# OpenAI: Realtime / Flexible TTS (URL optional)
OPENAI_API_KEY=
OPENAI_TTS_URL=https://api.openai.com/v1/audio/speech

# Flexible: selected providers required
# ModelArk
BYTEPLUS_MODEL_ENDPOINT_ID=
BYTEPLUS_MODEL_API_KEY=
# Custom LLM: falls back to OPENAI_API_KEY
CUSTOM_LLM_API_KEY=
# ASR / TTS: BytePlus
BYTEPLUS_SEED_SPEECH_APP_ID=
BYTEPLUS_SEED_SPEECH_ACCESS_TOKEN=
# ASR / TTS: Amazon
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Google ASR/TTS: quoted single-line JSON; recognizer required for ASR v2
GOOGLE_CREDENTIALS_JSON=
GOOGLE_RECOGNIZER_PATH=

# Optional: web search (Flexible), avatars (Volcano / Akool)
ASKECHO_API_KEY=
ASKECHO_BOT_ID=
AVATAR_APP_ID=
AVATAR_TOKEN=
AKOOL_API_KEY=

# Optional: local ports and API URL (empty uses the development proxy)
PORT=
SERVER_PORT=3001
REACT_APP_AIGC_PROXY_HOST=

BYTEPLUS_MODEL_ENDPOINTS={}
SESSION_DURATION_SECONDS=1800

GOOGLE_LLM_API_KEY=
CUSTOM_LLM_URL=
