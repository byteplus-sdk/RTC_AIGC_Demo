# Required to run the API server
RTC_APP_ID=
RTC_APP_KEY=
BYTEPLUS_ACCESS_KEY_ID=
BYTEPLUS_SECRET_ACCESS_KEY=

# Required for Realtime; also used by Flexible OpenAI LLM and TTS
OPENAI_API_KEY=

# Flexible LLM: ModelArk (endpoint ID can also be entered in Configure)
BYTEPLUS_MODEL_ENDPOINT_ID=
BYTEPLUS_MODEL_API_KEY=
# Optional JSON map of model names to endpoints
BYTEPLUS_MODEL_ENDPOINTS={}
# Google LLM
GOOGLE_LLM_API_KEY=
# Custom LLM: exact HTTPS endpoint and its dedicated API key
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_URL=

# Flexible ASR / TTS: BytePlus (shared speech credentials)
BYTEPLUS_SEED_SPEECH_APP_ID=
BYTEPLUS_SEED_SPEECH_ACCESS_TOKEN=
# AI Gateway: configure a wss:// URL and API key for each selected module
ASR_GATEWAY_API_URL=
ASR_GATEWAY_API_KEY=
TTS_GATEWAY_API_URL=
TTS_GATEWAY_API_KEY=
# ASR / TTS: Amazon
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Google ASR/TTS: quoted single-line JSON; recognizer required for ASR v2
GOOGLE_CREDENTIALS_JSON=
GOOGLE_RECOGNIZER_PATH=

# Optional OpenAI TTS endpoint
OPENAI_TTS_URL=https://api.openai.com/v1/audio/speech

# Optional: web search (Flexible), avatars (Volcano / Akool)
ASKECHO_API_KEY=
ASKECHO_BOT_ID=
AVATAR_APP_ID=
AVATAR_TOKEN=
AKOOL_API_KEY=

# Optional: local ports and API URL (empty uses the development proxy)
PORT=
SERVER_PORT=3001
REACT_APP_AIGC_PROXY_HOST=
# Deployed frontend origin, e.g. https://demo.example.com
DEMO_WEB_ORIGIN=

SESSION_DURATION_SECONDS=1800
