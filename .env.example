# Project identity. Keep real values in .env.local and never commit them.
RTC_APP_ID=

# Optional direct OpenAPI mode. When absent, byteplus-rtc Signin is used.
BYTEPLUS_ACCESS_KEY_ID=
BYTEPLUS_SECRET_ACCESS_KEY=

# Resource values used by the default BytePlus scene.
BYTEPLUS_MODEL_ENDPOINT_ID=
BYTEPLUS_MODEL_API_KEY_ID=
BYTEPLUS_SEED_SPEECH_APP_ID=

# Optional raw credentials for direct OpenAPI mode. CLI mode exchanges the
# selector IDs above in memory and does not expose these values to Node.
BYTEPLUS_MODEL_API_KEY=
BYTEPLUS_SEED_SPEECH_ACCESS_TOKEN=

# Optional local-token fallback. Remote GetToken is used when this is absent.
RTC_APP_KEY=
